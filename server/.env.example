# Copy to server/.env and adjust. Never commit server/.env.
HOST=127.0.0.1
PORT=3001
# Comma-separated origins allowed to call the API from another origin. Empty = same-origin only.
CORS_ORIGIN=
# Matches compose.yaml (`npm run db:up`). If you set POSTGRES_PORT, change the port here too.
DATABASE_URL=postgres://movieshelf:movieshelf@127.0.0.1:5432/movieshelf
# TMDB (optional): real Where to Watch data and `npm run tmdb:import`. Get a free key at
# https://www.themoviedb.org/settings/api — either the "API Key" or the "API Read Access Token" works.
# Server-side only; it is never sent to the browser.
TMDB_API_KEY=
